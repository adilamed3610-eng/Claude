---
// Wrap any outbound monetized link with this so disclosure + SEO attributes stay consistent everywhere.
interface Props {
  href: string;
  label?: string;
}

const { href, label } = Astro.props;
---

<a href={href} rel="sponsored noopener" target="_blank" class="affiliate-link">
  <slot>{label}</slot>
  <span class="badge">↗</span>
</a>

<style>
  .affiliate-link {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-terracotta);
  }
  .badge { font-size: 0.75em; opacity: 0.6; }
</style>
