---
import { SITE_TITLE } from '../consts';
---

<header>
  <a class="brand" href="/">{SITE_TITLE}</a>
  <nav>
    <a href="/blog">Blog</a>
    <a href="/freebie">Free Trip Checklist</a>
    <a href="/about">About</a>
  </nav>
</header>

<style>
  header {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .brand {
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-night);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    color: var(--color-night);
    text-decoration: none;
    font-weight: 600;
  }
  nav a:hover { color: var(--color-terracotta); }
</style>
