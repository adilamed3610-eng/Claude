# Upwork OAuth Credentials
# Get these from https://www.upwork.com/o/profiles/settings/applications
UPWORK_CLIENT_ID=your_client_id
UPWORK_CLIENT_SECRET=your_client_secret

# OAuth Callback (local development)
UPWORK_CALLBACK_URL=http://localhost:3000/callback

# Server Configuration
PORT=3000
NODE_ENV=development

# Encryption key for storing tokens (generate a random 32-char string)
ENCRYPTION_KEY=your_encryption_key_here
